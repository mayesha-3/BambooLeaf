# Backend
PORT=3000
NODE_ENV=development
# Keep 0 unless requests pass through a known proxy chain that overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Interface the API listens on. Keep 127.0.0.1 unless you deliberately expose the API.
HOST=127.0.0.1
# Starting autonomy level: L0 blocks all actions, L1 needs human approval (default), L2 and L3 allow auto-execution within policy.
AUTONOMY_LEVEL=L1
# Local Anvil node used by the Attack Arena sandbox wallet.
ARENA_SANDBOX_RPC_URL=http://127.0.0.1:8547
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=guarded_agent_wallet
OWNER_API_TOKEN=
OWNER_WALLET_ADDRESS=
AUDITOR_WALLET_ADDRESSES=
APPROVER_WALLET_ADDRESSES=
CLERK_WALLET_ADDRESSES=
ARENA_RATE_LIMIT_WINDOW_MS=60000
ARENA_RATE_LIMIT_MAX_REQUESTS=10

# EVM chain: local Anvil for development; Sepolia for testnet evidence
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
SHADOW_RPC_URL=http://127.0.0.1:8546
AGENT_KEY=
MAX_AGENT_BALANCE=
MAX_PER_TX_ETH=0.02
MAX_PER_RECIPIENT_PER_DAY_ETH=0.05
MAX_TX_PER_WINDOW=5
VELOCITY_WINDOW_SECONDS=600
ALLOWED_RECIPIENTS=

# OpenAI-compatible planner and quarantined model providers
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=
ALIBABA_MODEL=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
QUARANTINE_BASE_URL=
QUARANTINE_API_KEY=
QUARANTINE_MODEL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=15000

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
