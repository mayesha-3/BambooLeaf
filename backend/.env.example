PORT=3000
NODE_ENV=development
# Keep 0 unless requests pass through a known proxy chain that overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
FRONTEND_ORIGIN=http://localhost:5173
# Local interface override; Render exposes the API through its proxy.
HOST=127.0.0.1
# Starting autonomy level: L0 blocks all actions, L1 needs human approval (default), L2 and L3 allow auto-execution within policy.
AUTONOMY_LEVEL=L1
# Local Anvil node used by the Attack Arena sandbox wallet.
ARENA_SANDBOX_RPC_URL=http://127.0.0.1:8547
------MONGODB------------
MONGODB_USERNAME=
MONGODB_PASSWORD=
