# Copy to .env (git-ignored) and fill in yourself. Placeholders only; every value marked UNVERIFIED must be checked against the provider's current docs.
PROVIDERS=alibaba,siliconflow

# Alibaba Cloud Model Studio (UNVERIFIED: base URL, JSON mode, thinking switch)
PROVIDER_ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
PROVIDER_ALIBABA_API_KEY=
PROVIDER_ALIBABA_EXTRA_BODY={"enable_thinking":false}
PROVIDER_ALIBABA_JSON_MODE=true

# SiliconFlow (UNVERIFIED: base URL, JSON mode, thinking switch)
PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
PROVIDER_SILICONFLOW_API_KEY=
PROVIDER_SILICONFLOW_EXTRA_BODY={"enable_thinking":false}
PROVIDER_SILICONFLOW_JSON_MODE=true

# Ordered failover chains: provider:model,provider:model (split on the FIRST colon). Fill model ids yourself.
PLANNER_CHAIN=alibaba:REPLACE_WITH_MODEL_ID,siliconflow:REPLACE_WITH_MODEL_ID
QUARANTINE_CHAIN=

# Optional tuning
PLANNER_TOKENS=ETH,USDC
PLANNER_CHAIN_ID=11155111
PLANNER_DEFAULT_SLIPPAGE_BPS=50
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=600
LLM_TOTAL_TOKEN_BUDGET=200000
