# Copy to .env (git-ignored) and fill in yourself. Placeholders only. Never commit a real key.
# Groq settings below were tested live on 2026-10-15 (check:providers and the full evaluation).
PROVIDERS=groq

# Groq (free tier, no card needed. Limits per model on the free tier: about 8K tokens/min, 200K tokens/day.)
PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_GROQ_API_KEY=
PROVIDER_GROQ_EXTRA_BODY={"reasoning_effort":"low"}
PROVIDER_GROQ_JSON_MODE=true

# Ordered failover chains: provider:model,provider:model (split on the FIRST colon).
# Model ids change over time. Check the Groq console model list if you get a 404.
PLANNER_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
# Used by the quarantined model (Day 3). Leave as is for now.
QUARANTINE_CHAIN=groq:openai/gpt-oss-20b

# Optional: other OpenAI-compatible providers. Not used today.
# SiliconFlow: needs account credit (Qwen3-8B is paid on the international site).
# PROVIDERS=groq,siliconflow
# PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# PROVIDER_SILICONFLOW_API_KEY=
# PROVIDER_SILICONFLOW_EXTRA_BODY={"enable_thinking":false}
# Alibaba Model Studio: needs a payment method to finish sign-up.
# PROVIDER_ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# PROVIDER_ALIBABA_API_KEY=
# PROVIDER_ALIBABA_EXTRA_BODY={"enable_thinking":false}

# Optional tuning
PLANNER_TOKENS=ETH,USDC
PLANNER_CHAIN_ID=11155111
PLANNER_DEFAULT_SLIPPAGE_BPS=50
LLM_TIMEOUT_MS=20000
# Reasoning models count their thinking tokens, so keep this at 800 or more.
LLM_MAX_OUTPUT_TOKENS=800
LLM_TOTAL_TOKEN_BUDGET=300000